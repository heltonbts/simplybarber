generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(cuid())
  name             String?
  email            String          @unique
  emailVerified    DateTime?
  image            String?
  phone            String?
  bookings         Booking[]       @relation("ClientBookings")
  ownedBarbershops Barbershop[]    @relation("BarbershopOwner")
  accounts         Account[]
  sessions         Session[]
  Authenticator    Authenticator[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  Barber           Barber[]
}

model Barber {
  id           String     @id @default(uuid())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barbershopId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  bookings     Booking[]

  @@unique([userId, barbershopId])
}

model BarbershopWorkingHour {
  id           String     @id @default(uuid())
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barbershopId String
  weekDay      Int // 0 (domingo) a 6 (sábado)
  isOpen       Boolean    @default(true)
  openTime     String
  closeTime    String
  lunchStart   String?
  lunchEnd     String?

  @@unique([barbershopId, weekDay])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Barbershop {
  id                    String                  @id @default(uuid())
  name                  String
  address               String
  phone                 String[]
  description           String
  imageUrl              String
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  owner                 User                    @relation("BarbershopOwner", fields: [ownerId], references: [id])
  ownerId               String
  services              BarbershopService[]
  bookings              Booking[]
  Barber                Barber[]
  BarbershopWorkingHour BarbershopWorkingHour[]
}

model BarbershopService {
  id                String     @id @default(uuid())
  barbershop        Barbershop @relation(fields: [barbershopId], references: [id])
  barbershopId      String
  name              String
  description       String
  price             Decimal    @db.Decimal(10, 2)
  imageUrl          String
  durationInMinutes Int
  bookings          Booking[]
}

model Booking {
  id           String            @id @default(uuid())
  date         DateTime
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User?             @relation("ClientBookings", fields: [userId], references: [id])
  userId       String?
  service      BarbershopService @relation(fields: [serviceId], references: [id])
  serviceId    String
  barbershop   Barbershop        @relation(fields: [barbershopId], references: [id])
  barbershopId String
  clientName   String?
  clientPhone  String?
  notes        String?

  barber   Barber @relation(fields: [barberId], references: [id])
  barberId String

  @@unique([barberId, date])
}
